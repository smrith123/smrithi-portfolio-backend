PORT=5000
# development locally; production on Render (hides internal error messages, requires CORS_ORIGIN).
NODE_ENV=development

# MongoDB Atlas connection string. The database name in the path is required (the API refuses to start without it).
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smrithi-portfolio?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is rejected at boot.
JWT_SECRET=replace-me-with-a-48-byte-random-string
JWT_EXPIRES_IN=7d

FROM_NAME=Smrithi Portfolio

# Origins allowed to call the API: the public site and the admin, exact, comma-separated, no trailing slash.
# Required in production, e.g. https://smrithi.example,https://admin.smrithi.example
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Informational only: the API does not read these two.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# After every admin save the API calls the public site's revalidate endpoint, so the next
# page view shows the change. REVALIDATE_SECRET must match the site's (32+ characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave both blank locally: the site then refreshes on its 10-second timer.
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=

# Absolute URL this API is reachable at (used in the startup log).
PUBLIC_API_URL=http://localhost:5000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Largest upload request in MB. Cloudinary's free plan takes 100MB per video, 10MB per image.
MAX_UPLOAD_MB=100

# The one admin account. Defaults for local development live in src/config/admin.ts;
# these override them. ADMIN_PASSWORD is required in production (the API refuses to
# start without it), so the live password is never in a committed file.
ADMIN_EMAIL=admin@smrithi.com
ADMIN_PASSWORD=
ADMIN_NAME=Smrithi
